# KuroStream runtime configuration
# 复制为 .env（docker）或写入 /etc/kurostream/env（systemd）

KS_HOST=0.0.0.0
KS_PORT=8000
KS_WORKERS=2

# 站点品牌（前端标题与副标题）
KS_SITE_NAME=KuroStream
KS_TAGLINE=高清片库 · 极速播放

# 抓取/转发调优
KS_MIN_INTERVAL=0.35
KS_TIMEOUT=30
KS_RETRIES=3
KS_CACHE_TTL=300
KS_LOG_LEVEL=info

# 出站代理（可选，海外 VPS 一般留空）
KS_PROXY=

# 对外绝对地址。网页同源访问可留空；
# 打包 iOS / Android 外壳时必须填，否则壳里取不到播放分片
KS_PUBLIC_BASE=

# ---------------- 会员与收款 ----------------
# 收款账号：填了才会在定价页出现该渠道
KS_PAY_ALIPAY=            # 支付宝收款码链接或账号，如 https://qr.alipay.com/xxxx
KS_PAY_USDT=              # USDT-TRC20 地址，如 Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KS_PAY_MANUAL=            # 人工客服联系方式，如 TG: @yourname
KS_PAY_NOTE=付款时务必备注订单号，否则无法自动到账确认

# 后台确认收款 / 查看统计的管理令牌（务必改成一串随机字符）
KS_ADMIN_TOKEN=

# 订单库路径（默认 kurostream.db，与代码同目录）
KS_DB=kurostream.db

# 开发模式：允许用 preview_tier 参数预览各档画质（生产必须为 0）
KS_DEV_MODE=0
